# NHL 21 settings: KEY=value, one per line (an empty value keeps the default).
# A variable set in the environment when starting nhl21.sh wins over this file.

# Fullscreen: 1 on, 0 windowed
BB_FULLSCREEN=0
# FPS limit: 60, 120, 144, 240 or 0 (no limit; the game itself runs at 60)
BB_FPS_LIMIT=
# Present mode: Mailbox, Fifo (vsync) or Immediate (may tear)
BB_PRESENT_MODE=
# Window size for 2K / 4K: 2560x1440 or 3840x2160 (the game's 1080p frame is scaled to it).
BB_WINDOW_SIZE=
# Upscaling with AMD FSR 1.0 (1 on) and RCAS sharpening (1 on; attenuation 200 sharp .. 2000 soft)
BB_FSR1=0
BB_RCAS=0
BB_RCAS_ATTENUATION=500
# The player name the game shows (16 ASCII characters)
BB_USER_NAME=Player 1
# Game language: 1 English (US), 2 French, 4 German, 5 Italian, 3 Spanish (Spain),
# 20 Spanish (Latin America), 17 Portuguese (Brazil), 16 Polish, 8 Russian, 0 Japanese,
# 10 Chinese (Traditional)
BB_LANGUAGE=1
# The monitor: its number (1, 2, ...) or part of its name
BB_DISPLAY=
# PS4 Pro mode: 1 on
BB_NEO=0
# Holding Circle for 2 seconds asks "Quit NHL 21?": 0 turns it off
BB_HOLD_CIRCLE_QUIT=1
